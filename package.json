{
  "name": "dtp-africa",
  "private": true,
  "version": "0.1.0",
  "description": "DirectToPro Africa — unified platform (Home, ScoreBoard, SIP, MVCE)",
  "scripts": {
    "dev": "pnpm --filter @dtp/web dev",
    "dev:api": "pnpm --filter @dtp/engines build && pnpm --filter @dtp/api dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:push": "pnpm --filter @dtp/api db:push",
    "db:seed": "pnpm --filter @dtp/api prisma:seed",
    "calibrate": "pnpm --filter @dtp/api calibrate",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
