# DTP FairPlay Edge — shared settings. Copy to `.env` and replace every CHANGE_ME.
# The Edge refuses to start while a secret is missing, shorter than 24 characters, or still
# a placeholder. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit `.env`.

# ── secrets ────────────────────────────────────────────────────────────────
# Bearer token for every Edge API route except /edge/v1/healthz.
FAIRPLAY_EDGE_API_TOKEN=CHANGE_ME
# The Edge's own MediaMTX user (API + playback). Stored in MediaMTX's config as a hash.
FAIRPLAY_MEDIAMTX_PASSWORD=CHANGE_ME
FAIRPLAY_MEDIAMTX_USER=fairplay-edge

# ── exposure ───────────────────────────────────────────────────────────────
# Where the Edge API is reachable on the host. 127.0.0.1 = this machine only. Anything else
# requires both TLS settings below (Phase 2 issues the Edge's own certificate).
FAIRPLAY_EDGE_HOST_BIND=127.0.0.1
FAIRPLAY_EDGE_TLS_CERT=
FAIRPLAY_EDGE_TLS_KEY=
FAIRPLAY_EDGE_PORT=8443
# Where cameras/encoders publish (RTSP 8554). Set to the Edge's venue-LAN address at a venue.
FAIRPLAY_INGEST_BIND=127.0.0.1
# Networks allowed to publish, comma-separated. MediaMTX treats an empty list as "any IP",
# so this must not be empty. 172.31.250.0/24 is the compose network (synthetic feeds); add
# the venue LAN. Under Docker Desktop, LAN publishers appear as the Docker gateway, so the
# per-source credentials are the real control there.
FAIRPLAY_PUBLISH_ALLOWED_CIDRS=172.31.250.0/24

# ── recording (MediaMTX) ───────────────────────────────────────────────────
# Part = recovery point: a crash loses at most the part being written.
FAIRPLAY_RECORD_PART_DURATION=1s
# Minimum segment length; a segment is hashed when it closes. See the Phase 1 report.
FAIRPLAY_RECORD_SEGMENT_DURATION=5m

# ── watchdog ───────────────────────────────────────────────────────────────
FAIRPLAY_POLL_SECONDS=2
# A closed feed's last segment is finalised after this many quiet seconds.
FAIRPLAY_FINALIZE_QUIET_SECONDS=10
# Publishing but not written for this long raises recording_stalled.
FAIRPLAY_RECORD_STALL_SECONDS=6
FAIRPLAY_DISK_SOFT_FREE_GB=20
FAIRPLAY_DISK_HARD_FREE_GB=5

# ── retention ──────────────────────────────────────────────────────────────
# Empty = off (the default). Set a whole number of days only after the organiser agrees a
# period. Protected (held) and unsynced-evidence segments are never deleted.
FAIRPLAY_RETENTION_DAYS=
FAIRPLAY_RETENTION_MAX_DELETIONS=50

FAIRPLAY_DEVICE_LABEL=edge-dev
