# DTP FairPlay Edge — publish credentials. Copy to `publish.env` and replace every CHANGE_ME.
# Read only by `init` (which hashes them into MediaMTX's config) and the synthetic feeds;
# the Edge API never sees them, so a compromised Edge cannot publish a fake feed.
# One per source in sources.toml: FAIRPLAY_PUBLISH_PASSWORD_<NAME in capitals>.
# The publish user for a source is `pub-<name>`. Never commit `publish.env`.
FAIRPLAY_PUBLISH_PASSWORD_GROUND=CHANGE_ME
FAIRPLAY_PUBLISH_PASSWORD_DRONE=CHANGE_ME
