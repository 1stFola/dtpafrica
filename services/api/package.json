{
  "name": "@dtp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-path=./src -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/services/api/src/main.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "echo ok",
    "prisma:generate": "prisma generate",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:repair:squad-duplicates": "tsx scripts/repair-sb-team-squad-duplicates.ts",
    "db:repair:joemark-venues": "tsx scripts/repair-joemark-venues.ts",
    "db:repair:player-lookup-keys": "tsx scripts/repair-player-lookup-keys.ts",
    "db:repair:player-stats": "tsx scripts/repair-player-stats.ts",
    "db:repair:player-display-names": "tsx scripts/repair-player-display-names.ts",
    "db:repair:competition-status": "tsx scripts/repair-competition-status.ts",
    "db:purge:gate-litter": "tsx scripts/purge-vision-gate-litter.ts",
    "db:purge:placeholder-players": "tsx scripts/purge-placeholder-players.ts",
    "db:push": "prisma db push --accept-data-loss",
    "calibrate": "pnpm --filter @dtp/engines build && tsx scripts/run-calibration.ts",
    "vision:selfcheck": "tsx scripts/vision-phase0-selfcheck.ts",
    "vision:r2check": "tsx scripts/vision-r2-check.ts",
    "vision:jobcheck": "tsx scripts/vision-job-loop-check.ts",
    "vision:e2echeck": "tsx scripts/vision-worker-e2e-check.ts",
    "vision:uploadcheck": "tsx scripts/vision-upload-resume-check.ts",
    "vision:annotationcheck": "tsx scripts/vision-annotation-check.ts",
    "vision:seed-demo": "tsx scripts/vision-seed-demo.ts",
    "vision:datasetcheck": "tsx scripts/vision-dataset-check.ts",
    "vision:catalogcheck": "tsx scripts/vision-catalog-check.ts",
    "vision:modelcheck": "tsx scripts/vision-model-registry-check.ts",
    "vision:boxcheck": "tsx scripts/vision-boxes-check.ts",
    "vision:benchcheck": "tsx scripts/vision-benchmark-check.ts",
    "vision:promotioncheck": "tsx scripts/vision-promotion-check.ts",
    "vision:trackcheck": "tsx scripts/vision-track-check.ts",
    "vision:trackmetricscheck": "tsx scripts/vision-track-metrics-check.ts",
    "vision:teamcheck": "tsx scripts/vision-team-check.ts",
    "vision:identitycheck": "tsx scripts/vision-identity-check.ts",
    "vision:identitymetricscheck": "tsx scripts/vision-identity-metrics-check.ts",
    "vision:calibrationcheck": "tsx scripts/vision-calibration-check.ts",
    "vision:cutscheck": "tsx scripts/vision-cuts-check.ts",
    "vision:clockcheck": "tsx scripts/vision-clock-check.ts",
    "vision:gamestatecheck": "tsx scripts/vision-game-state-check.ts",
    "vision:eventcheck": "tsx scripts/vision-event-check.ts",
    "dev:tsx": "tsx watch src/main.ts",
    "db:sync:event-player-links": "tsx scripts/sync-event-player-links.ts",
    "db:sync:timeline-squad-numbers": "tsx scripts/sync-timeline-squad-numbers.ts",
    "db:sync:squad-from-timeline": "tsx scripts/sync-squad-from-timeline.ts",
    "db:dedupe:squad-members": "tsx scripts/dedupe-squad-members.ts",
    "db:report:duplicate-players": "tsx scripts/report-duplicate-players.ts",
    "db:merge:duplicate-players": "tsx scripts/merge-duplicate-players.ts",
    "db:merge:squad-duplicates": "tsx scripts/merge-squad-duplicates.ts",
    "db:merge:numbered-duplicates": "tsx scripts/merge-numbered-duplicates.ts",
    "db:link:unattributed-goals": "tsx scripts/link-unattributed-goals.ts",
    "db:report:idle-recordings": "tsx scripts/report-idle-recordings.ts",
    "db:report:unapproved-finished-sheets": "tsx scripts/report-unapproved-finished-sheets.ts",
    "db:report:player-stat-drift": "tsx scripts/report-player-stat-drift.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@dtp/engines": "workspace:*",
    "@dtp/vision-contracts": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^6.45.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.0",
    "allure-js-commons": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
