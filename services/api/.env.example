DATABASE_URL=postgresql://dtp:dtp@localhost:5432/dtp_africa
PORT=3000
ADMIN_API_KEY=dtp-dev-admin-1
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ACADEMY_JWT_SECRET=change-me-academy-jwt-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── FairPlay (docs/fairplay/phase-4-cloud.md) ───────────────────────────────
# Evidence storage: off until the private evidence bucket exists. Its own bucket and its own
# R2 token, scoped to that bucket only: never Vision's buckets or key.
FAIRPLAY_STORAGE_BACKEND=off
FAIRPLAY_R2_ENDPOINT=
FAIRPLAY_R2_ACCESS_KEY_ID=
FAIRPLAY_R2_SECRET_ACCESS_KEY=
FAIRPLAY_R2_BUCKET=
# Ed25519 private key (PKCS#8 PEM, "\n" for line breaks) that signs venue credential bundles.
# Generate on the server; never commit it. Without it, Edges cannot fetch bundles.
FAIRPLAY_BUNDLE_SIGNING_KEY=
# Optional: bundle life (hours), device token life (days), evidence kept in R2 (days, D10).
# FAIRPLAY_BUNDLE_TTL_HOURS=36
# FAIRPLAY_DEVICE_TOKEN_TTL_DAYS=365
# FAIRPLAY_EVIDENCE_RETENTION_DAYS=90
