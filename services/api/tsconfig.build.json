{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@dtp/engines": ["../../packages/engines/src/index.ts"],
      "@dtp/vision-contracts": ["../../packages/vision-contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "prisma/seed-scoreboard.ts",
    "prisma/seed-mvce.ts",
    "prisma/seed-legacy-academies.ts",
    "prisma/seed-legacy-players.ts",
    "prisma/seed-legacy-players-data.ts",
    "prisma/seed-ex-internationals-cup-2026.ts",
    "prisma/seed-goalkeeper-profiles.ts",
    "prisma/seed-jagaban-cup-2026.ts",
    "prisma/seed-jagaban-media-data.ts",
    "prisma/sync-player-age-categories.ts",
    "prisma/sync-scoreboard-event-player-links.ts",
    "prisma/sync-scoreboard-timeline-player-profiles.ts",
    "prisma/seed-scout-to-pro-international-tournament-2026.ts",
    "prisma/seed-scout-to-pro-international-tournament-2026-teams-fixtures.ts",
    // Not imported by seed-scoreboard any more (DSL teams/fixtures are live),
    // but still typechecked so the retained fixture data cannot rot.
    "prisma/seed-dsl-league-2026.ts",
    // The Vision gate scripts are the evidence for every increment gate, so they
    // are typechecked too. They were not, and a duplicate `const` in one of them
    // got as far as running before esbuild complained.
    "scripts/vision-*.ts",
  ],
  "exclude": ["node_modules", "dist", "prisma/seed.ts"]
}
