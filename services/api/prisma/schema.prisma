generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                  String    @id @default(uuid())
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  displayName         String    @map("display_name")
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  age                 Int?
  ageGroup            String?   @map("age_group")
  nationality         String?
  heightCm            Int?      @map("height_cm")
  weightKg            Float?    @map("weight_kg")
  dominantFoot        String?   @map("dominant_foot")
  positionPrimary     String    @map("position_primary")
  positionFull        String?   @map("position_full")
  positionSecondary   String?   @map("position_secondary")
  playingPhilosophies Json?     @map("playing_philosophies")
  playerPhotoUrl      String?   @map("player_photo_url")
  videoUrl            String?   @map("video_url")
  biography           String?   @db.Text
  slug                String    @unique
  academyId           String?   @map("academy_id")
  city                String?
  state               String?
  isFeatured          Boolean   @default(false) @map("is_featured")
  isPublic            Boolean   @default(false) @map("is_public")
  registrationStatus  String    @default("approved") @map("registration_status")
  guardianName        String?   @map("guardian_name")
  guardianEmail       String?   @map("guardian_email")
  guardianPhone       String?   @map("guardian_phone")
  overallRating       Int?      @map("overall_rating")
  offensiveRating     Int?      @map("offensive_rating")
  defensiveRating     Int?      @map("defensive_rating")
  ratingAttributes    Json?     @map("rating_attributes")
  benchmarkMetadata   Json?     @map("benchmark_metadata")
  mediaItems          Json?     @map("media_items")
  scoutingSummary     String?   @map("scouting_summary") @db.Text
  normalizedName      String?   @unique @map("normalized_name")
  careerGoals         Int       @default(0) @map("career_goals")
  careerAssists       Int       @default(0) @map("career_assists")
  careerAppearances   Int       @default(0) @map("career_appearances")
  careerMinutes       Int       @default(0) @map("career_minutes")
  careerCleanSheets   Int       @default(0) @map("career_clean_sheets")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  academy               Academy?                   @relation(fields: [academyId], references: [id], onDelete: SetNull)
  academyChangeRequests AcademyChangeRequest[]
  matchMetrics          PlayerMatchMetrics[]
  aggregatedMetrics     PlayerAggregatedMetrics[]
  tacticalScores        TacticalScores?
  philosophyFitRows     PhilosophyFitProfile[]
  positionFit           PositionFitSnapshot?
  scoreboardSquad       SbTeamSquad[]
  scoreboardMatchSquad  SbMatchSquadPlayer[]
  scoreboardEvents      SbMatchEvent[]             @relation("SbEventPlayer")
  scoreboardAssists     SbMatchEvent[]             @relation("SbEventAssistPlayer")
  competitionStats      SbPlayerCompetitionStats[]
  mvceValuations        MvceValuationRun[]
  /// Per-player consent, which overrides a partner-wide grant. Virtual field:
  /// the foreign key lives on the Vision side, so this table is unchanged.
  visionRightsScopes    VisionRightsScope[]
  /// Who a Vision track was said to be. Foreign key on the Vision side; see docs/vision/35.
  visionIdentities      VisionIdentityAssignment[]
  /// Vision's event candidates naming this player as the actor; see docs/vision/44.
  visionEventCandidates VisionEventCandidate[]

  @@index([academyId])
  @@index([positionPrimary])
  @@index([ageGroup])
  @@index([overallRating])
  @@index([isFeatured, isPublic])
  @@index([slug])
  @@map("players")
}

model BlogPost {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  excerpt       String?  @db.Text
  body          String   @db.Text
  coverImageUrl String?  @map("cover_image_url")
  isPublished   Boolean  @default(true) @map("is_published")
  publishedAt   DateTime @default(now()) @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Academy {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  contactPerson    String?  @map("contact_person")
  email            String?
  phone            String?
  city             String?
  country          String?
  description      String?  @db.Text
  foundedYear      Int?     @map("founded_year")
  logoUrl          String?  @map("logo_url")
  websiteUrl       String?  @map("website_url")
  loginUsername    String?  @unique @map("login_username")
  passwordHash     String?  @map("password_hash")
  subscriptionTier String?  @map("subscription_tier")
  maxPlayers       Int?     @map("max_players")
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  players        Player[]
  changeRequests AcademyChangeRequest[]
  /// The club's teams across every competition it has entered.
  teams          SbTeam[]
  /// Set when this academy is also a Vision footage partner.
  visionPartners VisionSourcePartner[]

  @@map("academies")
}

model AcademyChangeRequest {
  id          String    @id @default(uuid())
  academyId   String    @map("academy_id")
  playerId    String?   @map("player_id")
  kind        String
  status      String    @default("pending")
  payload     Json
  adminNotes  String?   @map("admin_notes") @db.Text
  submittedAt DateTime  @default(now()) @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([academyId, status])
  @@index([status, createdAt])
  @@index([playerId])
  @@map("academy_change_requests")
}

model StaticContent {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("static_content")
}

model ContactMessage {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String    @db.Text
  readAt     DateTime? @map("read_at")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([readAt, archivedAt])
  @@map("contact_messages")
}

model SupportReport {
  id                String    @id @default(uuid())
  audience          String    @default("internal_admin")
  reporterName      String?   @map("reporter_name")
  reporterEmail     String?   @map("reporter_email")
  category          String
  severity          String    @default("medium")
  status            String    @default("open")
  subject           String
  description       String    @db.Text
  pageUrl           String?   @map("page_url")
  recommendationKey String?   @map("recommendation_key")
  context           Json?
  adminNotes        String?   @map("admin_notes") @db.Text
  resolutionSummary String?   @map("resolution_summary") @db.Text
  playbookOutcome   String    @default("not_reviewed") @map("playbook_outcome")
  playbookProposal  String?   @map("playbook_proposal") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  resolvedAt        DateTime? @map("resolved_at")

  @@index([status, severity])
  @@index([category])
  @@index([playbookOutcome])
  @@index([createdAt])
  @@map("support_reports")
}

model Match {
  id          String    @id @default(uuid())
  externalRef String?   @map("external_ref")
  competition String?
  season      String?
  playedAt    DateTime? @map("played_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  metrics PlayerMatchMetrics[]

  @@map("matches")
}

model PlayerMatchMetrics {
  id                        String   @id @default(uuid())
  playerId                  String   @map("player_id")
  matchId                   String   @map("match_id")
  minutesPlayed             Float    @default(0) @map("minutes_played")
  ballTouches               Int      @default(0) @map("ball_touches")
  oneTouchPossessions       Int      @default(0) @map("one_touch_possessions")
  multiTouchPossessions     Int      @default(0) @map("multi_touch_possessions")
  possessionDurationSeconds Float    @default(0) @map("possession_duration_seconds")
  releaseLacesCount         Int      @default(0) @map("release_laces_count")
  releaseInsideFootCount    Int      @default(0) @map("release_inside_foot_count")
  releaseOtherFootzoneCount Int      @default(0) @map("release_other_footzone_count")
  leftFootTouchCount        Int      @default(0) @map("left_foot_touch_count")
  rightFootTouchCount       Int      @default(0) @map("right_foot_touch_count")
  leftFootReleaseCount      Int      @default(0) @map("left_foot_release_count")
  rightFootReleaseCount     Int      @default(0) @map("right_foot_release_count")
  leftFootReceiveCount      Int      @default(0) @map("left_foot_receive_count")
  rightFootReceiveCount     Int      @default(0) @map("right_foot_receive_count")
  leftFootKickingPowerMph   Float?   @map("left_foot_kicking_power_mph")
  rightFootKickingPowerMph  Float?   @map("right_foot_kicking_power_mph")
  totalDistanceMiles        Float    @default(0) @map("total_distance_miles")
  sprintDistanceYards       Float    @default(0) @map("sprint_distance_yards")
  firstStepAccelerations    Int      @default(0) @map("first_step_accelerations")
  intenseAccelerations      Int      @default(0) @map("intense_accelerations")
  kickingPowerMph           Float?   @map("kicking_power_mph")
  topSpeedMph               Float?   @map("top_speed_mph")
  sprints                   Int      @default(0)
  intenseTurns              Int      @default(0) @map("intense_turns")
  avgTurnEntrySpeedMph      Float?   @map("avg_turn_entry_speed_mph")
  avgTurnExitSpeedMph       Float?   @map("avg_turn_exit_speed_mph")
  leftTurns                 Int      @default(0) @map("left_turns")
  rightTurns                Int      @default(0) @map("right_turns")
  backTurns                 Int      @default(0) @map("back_turns")
  distanceWithBallYards     Float    @default(0) @map("distance_with_ball_yards")
  topSpeedWithBallMph       Float?   @map("top_speed_with_ball_mph")
  intenseTurnsWithBall      Int      @default(0) @map("intense_turns_with_ball")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
  @@index([playerId])
  @@index([matchId])
  @@map("player_match_metrics")
}

model PlayerAggregatedMetrics {
  id             String   @id @default(uuid())
  playerId       String   @map("player_id")
  season         String   @default("rolling")
  matchesPlayed  Int      @default(0) @map("matches_played")
  minutesPlayed  Float    @default(0) @map("minutes_played")
  rawAverages    Json     @map("raw_averages")
  derivedMetrics Json     @map("derived_metrics")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@map("player_aggregated_metrics")
}

model TacticalScores {
  id                           String   @id @default(uuid())
  playerId                     String   @unique @map("player_id")
  gegenpressScore              Float    @default(0) @map("gegenpress_score")
  tikiTakaScore                Float    @default(0) @map("tiki_taka_score")
  counterAttackScore           Float    @default(0) @map("counter_attack_score")
  totalFootballScore           Float    @default(0) @map("total_football_score")
  highLineScore                Float    @default(0) @map("high_line_score")
  wingerScore                  Float    @default(0) @map("winger_score")
  lowBlockScore                Float    @default(0) @map("low_block_score")
  quickReleaseScore            Float    @default(0) @map("quick_release_score")
  ballRetentionScore           Float    @default(0) @map("ball_retention_score")
  technicalCleanlinessScore    Float    @default(0) @map("technical_cleanliness_score")
  directPlayScore              Float    @default(0) @map("direct_play_score")
  flairScore                   Float    @default(0) @map("flair_score")
  pressResistanceScore         Float    @default(0) @map("press_resistance_score")
  possessionHubScore           Float    @default(0) @map("possession_hub_score")
  transitionExplosivenessScore Float    @default(0) @map("transition_explosiveness_score")
  isolationThreatScore         Float    @default(0) @map("isolation_threat_score")
  twoFootednessScore           Float    @default(0) @map("two_footedness_score")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([gegenpressScore])
  @@index([tikiTakaScore])
  @@index([counterAttackScore])
  @@index([totalFootballScore])
  @@index([wingerScore])
  @@index([highLineScore])
  @@index([lowBlockScore])
  @@map("tactical_scores")
}

model PhilosophyFitProfile {
  id                 String   @id @default(uuid())
  playerId           String   @map("player_id")
  formation          String
  philosophy         String
  positionSlot       String?  @map("position_slot")
  philosophyFitScore Float    @map("philosophy_fit_score")
  positionFitScore   Float    @map("position_fit_score")
  confidenceScore    Float    @map("confidence_score")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, philosophy, formation])
  @@map("philosophy_fit_profiles")
}

model PositionFitSnapshot {
  id                   String   @id @default(uuid())
  playerId             String   @unique @map("player_id")
  primaryPositionFit   String   @map("primary_position_fit")
  secondaryPositionFit String?  @map("secondary_position_fit")
  hybridFit            String?  @map("hybrid_fit")
  confidence           Float
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("position_fit_snapshots")
}

model TacticalBenchmark {
  id                 String   @id @default(uuid())
  playerName         String   @map("player_name")
  position           String
  country            String?
  clubStyle          String?  @map("club_style")
  tacticalArchetype  String?  @map("tactical_archetype")
  dominantFoot       String?  @map("dominant_foot")
  gegenpressScore    Float    @default(0) @map("gegenpress_score")
  tikiTakaScore      Float    @default(0) @map("tiki_taka_score")
  counterAttackScore Float    @default(0) @map("counter_attack_score")
  totalFootballScore Float    @default(0) @map("total_football_score")
  highLineScore      Float    @default(0) @map("high_line_score")
  wingerScore        Float    @default(0) @map("winger_score")
  lowBlockScore      Float    @default(0) @map("low_block_score")
  bestSystemFit      String?  @map("best_system_fit")
  description        String?  @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tactical_benchmarks")
}

// —— ScoreBoard (operational football data; separate from SIP `matches`) ——

model SbCompetition {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  season       String
  type         String   @default("tournament")
  status       String   @default("scheduled")
  formatType   String?  @map("format_type")
  formatConfig Json?    @map("format_config")
  country      String?  @default("Nigeria")
  /**
   * Competition crest. Teams already carry one; competitions did not, which
   * left the admin fixtures calendar deriving a monogram instead.
   */
  logoUrl      String?  @map("logo_url")
  description  String?  @db.Text
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teams            SbTeam[]
  matches          SbMatch[]
  highlights       SbHighlight[]
  stages           SbCompetitionStage[]
  playerStats      SbPlayerCompetitionStats[]
  scopedAdminUsers AdminUser[]
  recorderGrants   AdminUserCompetition[]
  /// Catalogued Vision footage mapped to this competition.
  visionSourceRecords VisionSourceVideoRecord[]

  standingsSnapshot  Json?     @map("standings_snapshot")
  standingsUpdatedAt DateTime? @map("standings_updated_at")

  @@index([formatType])
  @@map("sb_competitions")
}

model SbPlayerCompetitionStats {
  id            String @id @default(uuid())
  competitionId String @map("competition_id")
  playerId      String @map("player_id")
  goals         Int    @default(0)
  assists       Int    @default(0)
  appearances   Int    @default(0)
  minutesPlayed Int    @default(0) @map("minutes_played")
  cleanSheets   Int    @default(0) @map("clean_sheets")

  competition SbCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([competitionId, playerId])
  @@index([competitionId, goals])
  @@map("sb_player_competition_stats")
}

model SbCompetitionStage {
  id            String   @id @default(uuid())
  competitionId String   @map("competition_id")
  key           String
  name          String
  stageType     String   @map("stage_type")
  sortOrder     Int      @default(0) @map("sort_order")
  config        Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  competition SbCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     SbMatch[]

  @@unique([competitionId, key])
  @@map("sb_competition_stages")
}

model SbTeam {
  id            String   @id @default(uuid())
  competitionId String   @map("competition_id")
  slug          String
  name          String
  shortName     String?  @map("short_name")
  groupKey      String?  @map("group_key")
  logoUrl       String?  @map("logo_url")
  city          String?
  /// The club this entry belongs to. A club that enters several competitions
  /// has one SbTeam per competition; they share an academyId.
  academyId     String?  @map("academy_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  competition       SbCompetition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  academy           Academy?             @relation(fields: [academyId], references: [id], onDelete: SetNull)
  homeMatches       SbMatch[]            @relation("SbHomeTeam")
  awayMatches       SbMatch[]            @relation("SbAwayTeam")
  squad             SbTeamSquad[]
  events            SbMatchEvent[]
  matchSquadPlayers SbMatchSquadPlayer[]

  @@unique([competitionId, slug])
  @@index([academyId])
  @@map("sb_teams")
}

model SbTeamSquad {
  id          String  @id @default(uuid())
  teamId      String  @map("team_id")
  playerId    String? @map("player_id")
  shirtNumber Int?    @map("shirt_number")
  displayName String  @map("display_name")
  position    String?

  team              SbTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player            Player?              @relation(fields: [playerId], references: [id], onDelete: SetNull)
  matchSquadPlayers SbMatchSquadPlayer[]

  @@index([teamId])
  @@index([playerId])
  @@index([teamId, playerId])
  @@map("sb_team_squad")
}

model SbMatchSquadPlayer {
  id           String   @id @default(uuid())
  matchId      String   @map("match_id")
  teamId       String   @map("team_id")
  squadId      String?  @map("squad_id")
  playerId     String?  @map("player_id")
  playerName   String   @map("player_name")
  jerseyNumber Int?     @map("jersey_number")
  position     String?
  isStarter    Boolean  @default(false) @map("is_starter")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  match  SbMatch      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   SbTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  squad  SbTeamSquad? @relation(fields: [squadId], references: [id], onDelete: SetNull)
  player Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([matchId, teamId])
  @@index([teamId])
  @@index([playerId])
  @@index([squadId])
  @@map("sb_match_squad_players")
}

model SbMatch {
  id               String    @id @default(uuid())
  slug             String?   @unique
  competitionId    String    @map("competition_id")
  stageId          String?   @map("stage_id")
  homeTeamId       String    @map("home_team_id")
  awayTeamId       String    @map("away_team_id")
  status           String    @default("scheduled")
  minute           Int?
  homeScore        Int       @default(0) @map("home_score")
  awayScore        Int       @default(0) @map("away_score")
  kickoffAt        DateTime? @map("kickoff_at")
  venue            String?
  matchComment     String?   @map("match_comment") @db.Text
  roundLabel       String?   @map("round_label")
  stageKey         String?   @map("stage_key")
  matchday         Int?
  formationHome    String    @default("4-3-3") @map("formation_home")
  formationAway    String    @default("4-3-3") @map("formation_away")
  meta             Json?
  stats            Json?
  isPublished      Boolean   @default(true) @map("is_published")
  sipMatchId       String?   @map("sip_match_id")
  sipIngestStatus  String    @default("pending") @map("sip_ingest_status")
  sipIngestedAt    DateTime? @map("sip_ingested_at")
  sipIngestSummary Json?     @map("sip_ingest_summary")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  competition     SbCompetition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stage           SbCompetitionStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  homeTeam        SbTeam               @relation("SbHomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        SbTeam               @relation("SbAwayTeam", fields: [awayTeamId], references: [id])
  events          SbMatchEvent[]
  highlights      SbHighlight[]
  ingestAudits    SbSipIngestAudit[]
  squadPlayers    SbMatchSquadPlayer[]
  statisticsSheet SbMatchStatistics?
  /// Vision footage of this fixture: catalogued sources and acquired copies.
  visionSourceRecords VisionSourceVideoRecord[]
  visionVideoAssets   VisionVideoAsset[]

  @@index([competitionId, status])
  @@index([stageKey])
  @@index([stageId])
  @@index([sipIngestStatus])
  @@index([kickoffAt])
  @@map("sb_matches")
}

/**
 * Pitch-side statistics sheet for one match, with its own review workflow.
 * Separate from SbMatch.stats on purpose: SbMatch.stats is the *published*
 * figure the public Statistics tab reads, while this row is the working sheet
 * plus its audit trail. Approving copies totals across, so nothing half-tallied
 * can reach the public site.
 * Actor ids and names are stored flat rather than as relations: an audit trail
 * has to survive the deletion of the admin user it refers to.
 */
model SbMatchStatistics {
  id      String @id @default(uuid())
  matchId String @unique @map("match_id")

  /**
   * Statistics track: live | submitted | approved.
   * Statistics and events are reviewed independently — a recorder can send the
   * stat sheet up at full time while still tidying the event log, and neither
   * blocks the other. `status` and the unprefixed audit columns below belong to
   * the statistics track; the `events*` columns mirror them for the event log.
   */
  status String @default("live")

  /**
   * Event log track: live | submitted | approved.
   */
  eventsStatus String @default("live") @map("events_status")

  eventsSubmittedById   String?   @map("events_submitted_by")
  eventsSubmittedByName String?   @map("events_submitted_by_name")
  eventsSubmittedAt     DateTime? @map("events_submitted_at")

  eventsApprovedById   String?   @map("events_approved_by")
  eventsApprovedByName String?   @map("events_approved_by_name")
  eventsApprovedAt     DateTime? @map("events_approved_at")

  eventsSentBackById   String?   @map("events_sent_back_by")
  eventsSentBackByName String?   @map("events_sent_back_by_name")
  eventsSentBackAt     DateTime? @map("events_sent_back_at")
  eventsSentBackNote   String?   @map("events_sent_back_note") @db.Text

  /**
   * Raw tallies as the console records them, preserving the half split so a
   * second-half query can be answered later:
   * { "shots": { "1st": { "home": 0, "away": 0 }, "2nd": {...} },
   * "yellowCards": { "home": 0, "away": 0 } }
   * Stats that are not split by half carry the flat {home,away} shape.
   */
  tallies Json @default("{}")

  /**
   * Player events tapped on the Events tab, in recording order:
   * [{ id, type, minute, addedMinute, side, playerNumber, half }]
   * Approving turns each into an SbMatchEvent row with a generated comment.
   * Held here until then so nothing half-tapped reaches the public timeline.
   */
  events Json @default("[]")

  /**
   * Match clock: { halfLength, half, phase, firstHalfStartedAt, … }.
   * Stores wall-clock anchors rather than an elapsed count, so the running time
   * is derived on read. Switching tabs, reloading, or the phone locking cannot
   * lose it. Half length is set at kick-off because competitions run anywhere
   * from 30- to 45-minute halves.
   */
  clock Json?

  /**
   * Kit colours the two sides are actually wearing today, chosen by the
   * recorder: { home: "#e11d48", away: "#f8fafc" }. Per sheet rather than per
   * team because a team's kit changes match to match.
   */
  kits Json?

  /**
   * A recorder's pending request to reopen a locked sheet.
   * At full time the sheet locks. The recorder can ask for it back; a
   * ScoreBoard admin approving that request is what unlocks it, so a locked
   * record is never edited without someone signing off.
   */
  correctionRequestedSection String?   @map("correction_requested_section")
  correctionRequestedById    String?   @map("correction_requested_by")
  correctionRequestedByName  String?   @map("correction_requested_by_name")
  correctionRequestedAt      DateTime? @map("correction_requested_at")
  correctionRequestNote      String?   @map("correction_request_note") @db.Text

  /**
   * When an event was last filed on this sheet.
   *
   * Only an event moves it. A tally bump or a clock action does not, because a
   * recorder tapping shot counts while filing nothing is the case the idle guard is
   * meant to catch. `updatedAt` cannot serve: it moves on every save.
   *
   * Null means nothing has been filed yet, and the guard measures from kick-off
   * instead -- a match that starts and records nothing is precisely the walked-away
   * case, and would otherwise never trip.
   */
  lastEventAt DateTime? @map("last_event_at")

  /**
   * When the clock reached full time.
   *
   * Recorded on the transition rather than inferred, because full time locks the sheet
   * and nothing writes to it afterwards -- so `updatedAt` happens to sit at roughly the
   * right moment today and would stop doing so the first time anything else touched the
   * row. The auto-submit five minutes later is measured from here.
   */
  fullTimeAt DateTime? @map("full_time_at")

  /** Set when the sheet was submitted by the clock rather than by a person. */
  autoSubmittedAt DateTime? @map("auto_submitted_at")

  /**
   * Set by the idle sweep when a running clock goes 20 minutes with no event.
   *
   * A second kind of lock, and stored rather than derived: full time is a fact about
   * the clock that any reader can work out, while idleness is a fact about elapsed
   * wall time that nothing would notice if the recorder has closed their laptop --
   * which is the situation it exists for. While set, the sheet refuses edits and the
   * public broadcast stops; a ScoreBoard admin releases it with a note.
   */
  idleLockedAt      DateTime? @map("idle_locked_at")
  /** What the sweep measured from, so an alert can say how long it had been quiet. */
  idleLockedSinceAt DateTime? @map("idle_locked_since_at")

  idleReleasedById   String?   @map("idle_released_by")
  idleReleasedByName String?   @map("idle_released_by_name")
  idleReleasedAt     DateTime? @map("idle_released_at")
  idleReleaseNote    String?   @map("idle_release_note") @db.Text

  recorderId   String? @map("recorder_id")
  recorderName String? @map("recorder_name")

  submittedById   String?   @map("submitted_by")
  submittedByName String?   @map("submitted_by_name")
  submittedAt     DateTime? @map("submitted_at")

  approvedById   String?   @map("approved_by")
  approvedByName String?   @map("approved_by_name")
  approvedAt     DateTime? @map("approved_at")

  sentBackById   String?   @map("sent_back_by")
  sentBackByName String?   @map("sent_back_by_name")
  sentBackAt     DateTime? @map("sent_back_at")
  sentBackNote   String?   @map("sent_back_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  match SbMatch           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  log   SbMatchSheetLog[]

  @@index([status])
  @@index([eventsStatus])
  @@index([correctionRequestedAt])
  @@index([idleLockedAt])
  @@map("sb_match_statistics")
}

/**
 * Append-only history of everything that happened to a match sheet.
 * Submissions, resubmissions, approvals, send-backs, correction requests and
 * the approvals of those requests all land here, so a recorder can see what was
 * asked of them and an admin can trace who changed what. Actor names are stored
 * flat: a history has to survive the deletion of the account it refers to.
 */
model SbMatchSheetLog {
  id      String @id @default(uuid())
  sheetId String @map("sheet_id")
  matchId String @map("match_id")

  /**
   * stats | events
   */
  section String

  /**
   * submitted | resubmitted | approved | sent_back | correction_requested |
   * correction_approved | correction_declined
   */
  action String

  actorId   String? @map("actor_id")
  actorName String? @map("actor_name")
  /**
   * The role the actor held, so "who could do this" stays answerable later.
   */
  actorRole String? @map("actor_role")

  note String? @db.Text

  /**
   * Snapshot of what the sheet held at that moment, for change tracking.
   */
  summary Json?

  createdAt DateTime @default(now()) @map("created_at")

  sheet SbMatchStatistics @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([sheetId, createdAt])
  @@map("sb_match_sheet_log")
}

model SbSipIngestAudit {
  id        String   @id @default(uuid())
  matchId   String   @map("match_id")
  status    String
  message   String?  @db.Text
  summary   Json?
  createdAt DateTime @default(now()) @map("created_at")

  match SbMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("sb_sip_ingest_audits")
}

model SbMatchEvent {
  id             String   @id @default(uuid())
  matchId        String   @map("match_id")
  teamId         String?  @map("team_id")
  playerId       String?  @map("player_id")
  assistPlayerId String?  @map("assist_player_id")
  playerLabel    String?  @map("player_label")
  playerLabel2   String?  @map("player_label2")
  assistLabel    String?  @map("assist_label")
  type           String
  minute         Int
  detail         String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  match        SbMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         SbTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player       Player?       @relation("SbEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayer Player?       @relation("SbEventAssistPlayer", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  highlights   SbHighlight[]
  /// The Vision candidate promoted into this event, if one was; see docs/vision/44.
  visionCandidate VisionEventCandidate?

  @@index([matchId, minute])
  @@index([teamId])
  @@index([playerId])
  @@index([assistPlayerId])
  @@index([playerLabel])
  @@index([playerLabel2])
  @@index([assistLabel])
  @@map("sb_match_events")
}

model SbHighlight {
  id            String   @id @default(uuid())
  competitionId String?  @map("competition_id")
  matchId       String?  @map("match_id")
  eventId       String?  @map("event_id")
  title         String
  youtubeUrl    String   @map("youtube_url")
  mediaType     String   @default("video") @map("media_type")
  duration      String?  @map("duration")
  isPublished   Boolean  @default(true) @map("is_published")
  publishedAt   DateTime @default(now()) @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")

  competition SbCompetition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  match       SbMatch?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  event       SbMatchEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("sb_highlights")
}

// —— Admin RBAC ——

model AdminRole {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions AdminRolePermission[]
  users       AdminUser[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid())
  slug        String   @unique
  resource    String
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  roles AdminRolePermission[]

  @@index([resource, action])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  passwordHash    String?  @map("password_hash")
  roleId          String?  @map("role_id")
  /**
   * Legacy single-competition scope, superseded by `competitions`.
   * Kept so accounts created before recorders could hold several competitions
   * keep working: reads take the union of this and the join table. Nothing
   * writes to it any more.
   */
  competitionId   String?  @map("competition_id")
  /**
   * Grants every competition, present and future.
   * An explicit flag rather than "no competitions means all", so an account
   * whose scope was never filled in is refused instead of quietly being handed
   * the lot.
   */
  allCompetitions Boolean  @default(false) @map("all_competitions")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  role         AdminRole?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  competition  SbCompetition?         @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  competitions AdminUserCompetition[]

  @@index([roleId])
  @@index([competitionId])
  @@map("admin_users")
}

/**
 * Which competitions a match recorder may record for.
 * A join table rather than an array column so a deleted competition takes its
 * grants with it, instead of leaving ids pointing at nothing.
 */
model AdminUserCompetition {
  id            String   @id @default(uuid())
  adminUserId   String   @map("admin_user_id")
  competitionId String   @map("competition_id")
  createdAt     DateTime @default(now()) @map("created_at")

  adminUser   AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  competition SbCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, competitionId])
  @@index([adminUserId])
  @@index([competitionId])
  @@map("admin_user_competitions")
}

model MvceValuationRun {
  id                String   @id @default(uuid())
  playerId          String   @map("player_id")
  inputs            Json
  baseScore         Float    @map("base_score")
  adjustedScore     Float    @map("adjusted_score")
  confidenceLabel   String   @map("confidence_label")
  marketValueLabel  String   @map("market_value_label")
  marketValueMinEur Int?     @map("market_value_min_eur")
  marketValueMaxEur Int?     @map("market_value_max_eur")
  factors           Json
  multipliers       Json
  strengths         Json
  weaknesses        Json
  scoutNotes        String   @map("scout_notes") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("mvce_valuation_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Vision Engine — Phase 0
//
//  Football video intelligence. Full design: docs/vision/.
//
//  Three rules this block obeys, and every future Vision migration must too:
//
//  1. Every model is `Vision`-prefixed. The schema already holds TWO match
//     models — `Match` (SIP metrics) and `SbMatch` (ScoreBoard) — so a bare
//     `match` or `player` here would be a foreign key pointing at the wrong
//     table, which is a silent data-integrity failure.
//  2. No parallel football graph. Competitions, matches, teams, squads and
//     players already exist; Vision carries foreign keys into them.
//  3. Actor ids are stored flat, not as relations to AdminUser — the same
//     convention SbMatchStatistics uses. An audit trail has to survive the
//     deletion of the user it refers to, and api-key auth has no user row at
//     all.
// ═══════════════════════════════════════════════════════════════════════════

// ── Sources, rights and provenance ────────────────────────────────────────

/// An organisation DTP obtains footage from. Often, but not always, an existing
/// academy on the platform.
model VisionSourcePartner {
  id           String   @id @default(uuid())
  name         String
  academyId    String?  @map("academy_id")
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  academy      Academy?                           @relation(fields: [academyId], references: [id], onDelete: SetNull)
  channels     VisionSourceChannel[]
  videoRecords VisionSourceVideoRecord[]
  evidence     VisionRightsEvidence[]
  rightsScopes VisionRightsScope[]
  signatories  VisionPartnerAuthorizedSignatory[]
  uploadGrants VisionPartnerUploadGrant[]

  @@index([academyId])
  @@index([isActive])
  @@map("vision_source_partners")
}

/// A channel or feed a partner publishes through. Discovery metadata only.
model VisionSourceChannel {
  id         String   @id @default(uuid())
  partnerId  String   @map("partner_id")
  platform   String
  externalId String?  @map("external_id")
  url        String?
  title      String?
  createdAt  DateTime @default(now()) @map("created_at")

  partner      VisionSourcePartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  videoRecords VisionSourceVideoRecord[]

  @@unique([platform, externalId])
  @@index([partnerId])
  @@map("vision_source_channels")
}

/// Who at a partner may authorise an acquisition. Team Managers, per the
/// decision recorded in docs/vision/13-OPEN-QUESTIONS.md (Q1).
model VisionPartnerAuthorizedSignatory {
  id                  String    @id @default(uuid())
  partnerId           String    @map("partner_id")
  name                String
  role                String
  contactEmail        String?   @map("contact_email")
  contactPhone        String?   @map("contact_phone")
  authorityEvidenceId String?   @map("authority_evidence_id")
  activeFrom          DateTime  @map("active_from")
  activeTo            DateTime? @map("active_to")
  createdAt           DateTime  @default(now()) @map("created_at")

  partner           VisionSourcePartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  authorityEvidence VisionRightsEvidence?     @relation("SignatoryAuthorityEvidence", fields: [authorityEvidenceId], references: [id], onDelete: SetNull)
  authorisedRecords VisionSourceVideoRecord[]

  @@index([partnerId, activeFrom])
  @@map("vision_partner_authorized_signatories")
}

/// The document a rights claim rests on. Stored in the master bucket alongside
/// the footage it authorises, because the two must not be separable.
model VisionRightsEvidence {
  id           String    @id @default(uuid())
  partnerId    String    @map("partner_id")
  kind         String
  objectKey    String    @map("object_key")
  documentDate DateTime? @map("document_date")
  /// Flat actor id — see the header note.
  uploadedBy   String?   @map("uploaded_by")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  partner              VisionSourcePartner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  scopes               VisionRightsScope[]
  signatoryAuthorities VisionPartnerAuthorizedSignatory[] @relation("SignatoryAuthorityEvidence")

  @@index([partnerId, kind])
  @@map("vision_rights_evidence")
}

/// A grant of one or more of the four independent scopes.
///
/// Attaches at partner, source or player level. The policy service resolves
/// most-specific-wins and deny-beats-allow, which is how a player-level
/// withdrawal by a guardian overrides a partner-wide grant.
model VisionRightsScope {
  id                  String  @id @default(uuid())
  /// Exactly one of these three is set; `grantLevel` records which.
  partnerId           String? @map("partner_id")
  sourceVideoRecordId String? @map("source_video_record_id")
  playerId            String? @map("player_id")
  grantLevel          String  @map("grant_level")

  canAnalyze          Boolean @default(false) @map("can_analyze")
  canTrain            Boolean @default(false) @map("can_train")
  canPublishHighlight Boolean @default(false) @map("can_publish_highlight")
  canShareWithScout   Boolean @default(false) @map("can_share_with_scout")

  grantedAt     DateTime  @map("granted_at")
  expiresAt     DateTime? @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.Text
  revokedBy     String?   @map("revoked_by")
  /// Structured restrictions, e.g. territory or no-identifiable-minors.
  restrictions  Json?
  evidenceId    String?   @map("evidence_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  partner           VisionSourcePartner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sourceVideoRecord VisionSourceVideoRecord? @relation(fields: [sourceVideoRecordId], references: [id], onDelete: Cascade)
  player            Player?                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  evidence          VisionRightsEvidence?    @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([partnerId, revokedAt])
  @@index([sourceVideoRecordId, revokedAt])
  @@index([playerId, revokedAt])
  @@index([expiresAt])
  @@map("vision_rights_scopes")
}

/// A known video in the world. Metadata only, and never trainable on its own:
/// a URL registration cannot become a dataset member.
model VisionSourceVideoRecord {
  id              String    @id @default(uuid())
  partnerId       String    @map("partner_id")
  channelId       String?   @map("channel_id")
  externalVideoId String?   @map("external_video_id")
  url             String?
  title           String?
  publishedAt     DateTime? @map("published_at")
  durationSeconds Int?      @map("duration_seconds")

  sbMatchId       String? @map("sb_match_id")
  sbCompetitionId String? @map("sb_competition_id")

  /// The copyright owner, which is NOT always the partner granting access. A
  /// club can authorise a match a third-party videographer owns and published;
  /// conflating the two is how an unauthorised training source gets in.
  rightsOwnerName String? @map("rights_owner_name")

  sourceQualityRank String  @map("source_quality_rank")
  originalAvailable Boolean @default(false) @map("original_available")

  acquisitionStatus                  String    @map("acquisition_status")
  acquisitionMethod                  String?   @map("acquisition_method")
  acquisitionAuthorizedBySignatoryId String?   @map("acquisition_authorized_by_signatory_id")
  acquisitionAuthorizedAt            DateTime? @map("acquisition_authorized_at")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner       VisionSourcePartner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  channel       VisionSourceChannel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sbMatch       SbMatch?                          @relation(fields: [sbMatchId], references: [id], onDelete: SetNull)
  sbCompetition SbCompetition?                    @relation(fields: [sbCompetitionId], references: [id], onDelete: SetNull)
  authorizedBy  VisionPartnerAuthorizedSignatory? @relation(fields: [acquisitionAuthorizedBySignatoryId], references: [id], onDelete: SetNull)
  rightsScopes  VisionRightsScope[]
  videoAssets   VisionVideoAsset[]
  uploadGrants  VisionPartnerUploadGrant[]

  @@unique([channelId, externalVideoId])
  @@index([partnerId, acquisitionStatus])
  @@index([sbMatchId])
  @@index([sbCompetitionId])
  @@map("vision_source_video_records")
}

/// A scoped, expiring upload link for a partner with no DTP admin account.
/// Without this there is no way for a club secretary to hand over a master file.
model VisionPartnerUploadGrant {
  id                  String @id @default(uuid())
  partnerId           String @map("partner_id")
  sourceVideoRecordId String @map("source_video_record_id")
  /// Hashed at rest. The plaintext is shown once, at issue.
  tokenHash           String @unique @map("token_hash")
  /// Filled in when the holder actually starts an upload. Nothing is reserved at
  /// issue: a grant that is never used should leave no asset row behind.
  objectKey           String? @map("object_key")
  maxBytes            BigInt @map("max_bytes")
  allowedMimeTypes    String[] @map("allowed_mime_types")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  revokedAt           DateTime? @map("revoked_at")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  partner           VisionSourcePartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sourceVideoRecord VisionSourceVideoRecord @relation(fields: [sourceVideoRecordId], references: [id], onDelete: Cascade)
  uploadSessions    VisionUploadSession[]

  @@index([partnerId, expiresAt])
  @@map("vision_partner_upload_grants")
}

/// Rights withdrawal or an erasure request, routed for approval per policy.
/// Model lineage is never deleted: the auditable record that a source was used
/// and then excluded is itself the compliance artifact.
model VisionDeletionRequest {
  id           String    @id @default(uuid())
  videoAssetId String?   @map("video_asset_id")
  playerId     String?   @map("player_id")
  reason       String    @db.Text
  requestedBy  String?   @map("requested_by")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  state        String
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at")
  executedAt   DateTime? @map("executed_at")
  outcomeNotes String?   @map("outcome_notes") @db.Text

  videoAsset VisionVideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)

  @@index([state, requestedAt])
  @@index([videoAssetId])
  @@map("vision_deletion_requests")
}

// ── Media ─────────────────────────────────────────────────────────────────

/// Groups a match with its re-uploads, halves and highlight derivatives, so
/// they cannot be split across a train/test boundary.
model VisionDuplicateCluster {
  id                    String   @id @default(uuid())
  representativeAssetId String?  @map("representative_asset_id")
  method                String
  confidence            Float?
  createdAt             DateTime @default(now()) @map("created_at")

  assets VisionVideoAsset[]

  @@map("vision_duplicate_clusters")
}

/// An immutable copy of source footage under DTP control.
model VisionVideoAsset {
  id                  String  @id @default(uuid())
  sourceVideoRecordId String? @map("source_video_record_id")
  /// Nullable: a partner archive video can be catalogued and acquired before
  /// anyone has worked out which fixture it is. Required before inference runs.
  sbMatchId           String? @map("sb_match_id")

  /// The training firewall. Only `dtp_owned` may back a dataset member, which
  /// makes research-only footage structurally incapable of being trained on.
  corpus String

  objectKey             String  @unique @map("object_key")
  bytes                 BigInt
  mimeType              String  @map("mime_type")
  checksumSha256        String  @map("checksum_sha256")
  perceptualFingerprint String? @map("perceptual_fingerprint")
  duplicateClusterId    String? @map("duplicate_cluster_id")

  // FFprobe output, recorded by the worker. EC2 never opens a video file.
  container           String?
  videoCodec          String? @map("video_codec")
  width               Int?
  height              Int?
  fpsNumerator        Int?    @map("fps_numerator")
  fpsDenominator      Int?    @map("fps_denominator")
  isVariableFrameRate Boolean @default(false) @map("is_variable_frame_rate")
  durationMs          Int?    @map("duration_ms")

  ingestState String   @map("ingest_state")
  ingestError String?  @map("ingest_error") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sourceVideoRecord VisionSourceVideoRecord? @relation(fields: [sourceVideoRecordId], references: [id], onDelete: SetNull)
  sbMatch           SbMatch?                 @relation(fields: [sbMatchId], references: [id], onDelete: SetNull)
  duplicateCluster  VisionDuplicateCluster?  @relation(fields: [duplicateClusterId], references: [id], onDelete: SetNull)
  variants          VisionVideoVariant[]
  cameraSegments    VisionCameraSegment[]
  clockAnchors      VisionClockAnchor[]
  eventCandidates   VisionEventCandidate[]
  uploadSessions    VisionUploadSession[]
  jobs              VisionJob[]
  datasetMembers    VisionDatasetMember[]
  deletionRequests  VisionDeletionRequest[]
  annotationTasks   VisionAnnotationTask[]
  activeLearning    VisionActiveLearningItem[]
  tracks            VisionTrack[]

  @@index([checksumSha256])
  @@index([perceptualFingerprint])
  @@index([duplicateClusterId])
  @@index([sbMatchId])
  @@index([corpus, ingestState])
  @@map("vision_video_assets")
}

/// A derived rendition. Regenerable, unlike the master.
model VisionVideoVariant {
  id           String @id @default(uuid())
  videoAssetId String @map("video_asset_id")
  kind         String
  objectKey    String @map("object_key")
  width        Int?
  height       Int?
  /// Constant by construction for a proxy, which is what makes frame seeking
  /// deterministic.
  fps          Float?
  durationMs   Int?   @map("duration_ms")
  /// Source-to-proxy offset. Both times are carried everywhere because they
  /// diverge on variable-frame-rate sources and trimmed proxies.
  sourceOffsetMs Int      @default(0) @map("source_offset_ms")
  /// Hash of the encoder settings, so a re-run can be skipped rather than
  /// producing a subtly different proxy that invalidates annotations. It covers the
  /// recipe only -- crf, fps, height, pixel format -- and not the build that ran it.
  settingsHash   String?  @map("settings_hash")
  /// The FFmpeg build that produced this file, e.g. `ffmpeg 5.1.9-0+deb12u1`. Recorded
  /// because the CPU and GPU worker images ship different FFmpeg versions, so an
  /// identical settings hash does not promise two proxies are byte-identical. Null for
  /// variants written before this was recorded, and for thumbnails.
  encoder        String?
  bytes          BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  videoAsset VisionVideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@unique([videoAssetId, kind, objectKey])
  @@index([videoAssetId, kind])
  @@map("vision_video_variants")
}

/// Shot segmentation. Manual in Phase 1, model-assisted later.
///
/// Exists this early because replays and intros are the mechanism behind
/// duplicated events and shortcut learning, and retrofitting once events exist
/// is painful.
model VisionCameraSegment {
  id           String   @id @default(uuid())
  videoAssetId String   @map("video_asset_id")
  kind         String
  startMs      Int      @map("start_ms")
  endMs        Int      @map("end_ms")
  source       String
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  videoAsset   VisionVideoAsset        @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  calibrations VisionPitchCalibration[]

  @@index([videoAssetId, startMs])
  @@map("vision_camera_segments")
}

/// The match clock anchored to the footage: the source millisecond a person
/// marked as a half's kick-off, and the whistle that ended it when they marked
/// that too. One current row per half per asset; a new anchor supersedes.
model VisionClockAnchor {
  id           String   @id @default(uuid())
  videoAssetId String   @map("video_asset_id")
  /// 1, 2, and 3, 4 for extra time.
  half         Int
  sourceMs     Int      @map("source_ms")
  endMs        Int?     @map("end_ms")
  decidedBy    String   @map("decided_by")
  supersededBy String?  @map("superseded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  videoAsset VisionVideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@index([videoAssetId, half])
  @@map("vision_clock_anchors")
}

/// A homography from the proxy's pixels to the pitch in metres, for one camera
/// segment, with how far to trust it.
///
/// `quality` is what the suppression rule reads: `failed` yields no coordinates,
/// and nothing derived from this row may be emitted with a caveat instead
/// (docs/vision/09 § Calibration). A new calibration supersedes the segment's
/// current one; nothing is edited. The pitch's actual dimensions are on the row,
/// because assuming 105 × 68 on a short pitch corrupts every distance.
model VisionPitchCalibration {
  id                String   @id @default(uuid())
  cameraSegmentId   String   @map("camera_segment_id")
  pitchLengthM      Float    @map("pitch_length_m")
  pitchWidthM       Float    @map("pitch_width_m")
  /// manual | model
  method            String
  modelVersionId    String?  @map("model_version_id")
  /// [{ landmark, px, py, frameIndex? }] the fit was made from, proxy pixels.
  points            Json
  /// Row-major 3 x 3, pixel -> metres.
  homography        Json
  reprojectionErrorM  Float  @map("reprojection_error_m")
  maxPointErrorM      Float  @map("max_point_error_m")
  reprojectionErrorPx Float  @map("reprojection_error_px")
  pointsUsed        Int      @map("points_used")
  /// good | usable | failed
  quality           String
  thresholdsVersion String   @map("thresholds_version")
  decidedBy         String?  @map("decided_by")
  supersededBy      String?  @map("superseded_by")
  createdAt         DateTime @default(now()) @map("created_at")

  cameraSegment VisionCameraSegment @relation(fields: [cameraSegmentId], references: [id], onDelete: Cascade)

  @@index([cameraSegmentId, createdAt])
  @@map("vision_pitch_calibrations")
}

/// A resumable multipart upload. Server-side state, so resume survives a closed
/// browser, a new device or a reboot — which unstable Nigerian connectivity
/// makes a requirement rather than a nicety.
model VisionUploadSession {
  id               String  @id @default(uuid())
  videoAssetId     String? @map("video_asset_id")
  grantId          String? @map("grant_id")
  bucketId         String  @map("bucket_id")
  objectKey        String  @map("object_key")
  providerUploadId String  @map("provider_upload_id")
  partSizeBytes    Int     @map("part_size_bytes")
  expectedBytes    BigInt? @map("expected_bytes")
  bytesReceived    BigInt  @default(0) @map("bytes_received")
  /// [{ partNumber, etag, bytes }] — what the client may skip on resume.
  receivedParts    Json      @default("[]") @map("received_parts")
  state            String
  expiresAt        DateTime  @map("expires_at")
  completedAt      DateTime? @map("completed_at")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  videoAsset VisionVideoAsset?         @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  grant      VisionPartnerUploadGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@unique([bucketId, objectKey, providerUploadId])
  @@index([state, expiresAt])
  @@map("vision_upload_sessions")
}

// ── Jobs and compute ──────────────────────────────────────────────────────

/// The queue. Postgres rather than Redis in V1: job state has to be
/// transactionally consistent with rights, assets and review decisions, which
/// all live here, and a 2 GB box does not need another broker.
model VisionJob {
  id            String @id @default(uuid())
  type          String
  resourceClass String @map("resource_class")
  state         String
  priority      Int    @default(0)

  videoAssetId     String? @map("video_asset_id")
  datasetVersionId String? @map("dataset_version_id")
  modelVersionId   String? @map("model_version_id")

  inputSpec Json @map("input_spec")
  /// Every artifact this job writes must land under here. The control plane
  /// validates each presign request against it, which is why a worker needs no
  /// standing storage credentials.
  outputPrefix String @map("output_prefix")

  attemptNumber Int @default(1) @map("attempt_number")
  maxAttempts   Int @default(3) @map("max_attempts")

  /// Mandatory, not optional: the commonest way to burn GPU budget is a pod
  /// nobody noticed.
  budgetSeconds  Int @map("budget_seconds")
  budgetUsdCents Int @map("budget_usd_cents")

  queuedAt    DateTime  @default(now()) @map("queued_at")
  claimedAt   DateTime? @map("claimed_at")
  startedAt   DateTime? @map("started_at")
  heartbeatAt DateTime? @map("heartbeat_at")
  finishedAt  DateTime? @map("finished_at")

  workerId String? @map("worker_id")
  /// Opaque provider handle. Nothing outside the provider adapter may parse it,
  /// and it is deliberately named without a provider in it.
  providerRef String? @map("provider_ref")
  providerId  String? @map("provider_id")

  progress        Json?
  error           Json?
  idempotencyKey  String? @unique @map("idempotency_key")
  contractVersion String  @map("contract_version")

  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  videoAsset     VisionVideoAsset?     @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  datasetVersion VisionDatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  modelVersion   VisionModelVersion?   @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  events         VisionJobEvent[]
  cost           VisionJobCost?
  tracks         VisionTrack[]
  teamSides      VisionTeamSide[]

  /// The claim index: state, class and priority are exactly what the
  /// SKIP LOCKED claim query filters and orders by.
  @@index([state, resourceClass, priority, queuedAt])
  @@index([videoAssetId, type])
  @@index([heartbeatAt])
  @@map("vision_jobs")
}

/// One track: a run of linked detections of one class, from one `track` job.
///
/// A row per track and not per position: the positions live in the job's
/// artifact (docs/vision/04-DATA-MODEL.md § CV outputs), and this row is what a
/// reviewer selects, an identity attaches to, and a query filters on. Both
/// provenance ids are kept because a track is the product of two models.
model VisionTrack {
  id                String  @id @default(uuid())
  videoAssetId      String  @map("video_asset_id")
  inferenceJobId    String  @map("inference_job_id")
  localTrackId      Int     @map("local_track_id")
  class             String
  /// Source time, like every other label.
  startMs           Int     @map("start_ms")
  endMs             Int     @map("end_ms")
  startFrame        Int     @map("start_frame")
  endFrame          Int     @map("end_frame")
  detectionCount    Int     @map("detection_count")
  confirmed         Boolean @default(true)
  trackerVersionId  String? @map("tracker_version_id")
  detectorVersionId String? @map("detector_version_id")
  /// The artifact holding this track's positions.
  artifactKey       String  @map("artifact_key")
  createdAt         DateTime @default(now()) @map("created_at")

  videoAsset      VisionVideoAsset           @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  inferenceJob    VisionJob                  @relation(fields: [inferenceJobId], references: [id], onDelete: Cascade)
  teamAssignments VisionTeamAssignment[]
  identities      VisionIdentityAssignment[]
  eventCandidates VisionEventCandidate[]

  @@unique([inferenceJobId, localTrackId])
  @@index([videoAssetId, class])
  @@map("vision_tracks")
}

/// Which side a track is on, by kit appearance, as a machine proposed it.
///
/// One row per (track, identify job): a re-run proposes anew rather than editing.
/// `team` is null when the clustering could not say, and null is a correct answer.
/// Review corrections supersede, never overwrite, like every other prediction.
model VisionTeamAssignment {
  id             String  @id @default(uuid())
  trackId        String  @map("track_id")
  inferenceJobId String  @map("inference_job_id")
  /// A | B | null. Sides as clusters; the roster says which is which, later.
  team           String?
  /// The side the kit was nearest to, even when `team` is null: what unknown precision judges.
  nearestTeam    String? @map("nearest_team")
  confidence     Float?
  /// kit_cluster | kit_outlier | not_clustered | manual
  method         String
  /// Dominant kit colour the cluster was named by, for a reviewer's eye.
  kitDescription String? @map("kit_description")
  identifyVersionId String? @map("identify_version_id")
  /// unreviewed | accepted | corrected | rejected
  reviewState    String  @default("unreviewed") @map("review_state")
  supersededBy   String? @map("superseded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  track VisionTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, inferenceJobId])
  @@index([inferenceJobId])
  @@map("vision_team_assignments")
}

/// Which of the match's two teams a kit cluster is, as a person decided it.
///
/// Clusters are per identify job (a re-run may swap A and B), so the decision is
/// per job too. Both rows are written together and only by a signed-in person.
model VisionTeamSide {
  id             String   @id @default(uuid())
  inferenceJobId String   @map("inference_job_id")
  /// A | B
  team           String
  sbTeamId       String   @map("sb_team_id")
  decidedBy      String   @map("decided_by")
  createdAt      DateTime @default(now()) @map("created_at")

  inferenceJob VisionJob @relation(fields: [inferenceJobId], references: [id], onDelete: Cascade)

  @@unique([inferenceJobId, team])
  @@map("vision_team_sides")
}

/// Who a track is, for a window of it, as a person said -- never as a machine said.
///
/// `playerId` null means unknown, and unknown is a correct answer: nothing here may
/// pressure it toward a guess. The window makes identity time-aware: one track may
/// carry two people in turn (a split), and one person may span several tracks (a
/// merge, written as `propagated` rows). A new assignment supersedes every current
/// one its window overlaps; nothing is edited. Public attribution reads only rows a
/// *second* person accepted.
model VisionIdentityAssignment {
  id                 String   @id @default(uuid())
  trackId            String   @map("track_id")
  playerId           String?  @map("player_id")
  /// The roster slot in this match the assignment names; null for unknown.
  matchSquadPlayerId String?  @map("match_squad_player_id")
  sbTeamSquadId      String?  @map("sb_team_squad_id")
  sbTeamId           String?  @map("sb_team_id")
  confidence         Float
  /// manual | propagated. `jersey` and `roster_constraint` are reserved for machine proposals, later.
  method             String
  validFromMs        Int      @map("valid_from_ms")
  validToMs          Int      @map("valid_to_ms")
  /// unreviewed | accepted | rejected
  reviewState        String   @default("unreviewed") @map("review_state")
  decidedBy          String   @map("decided_by")
  reviewedBy         String?  @map("reviewed_by")
  note               String?
  supersededBy       String?  @map("superseded_by")
  createdAt          DateTime @default(now()) @map("created_at")

  track  VisionTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  player Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([trackId])
  @@index([playerId])
  @@map("vision_identity_assignments")
}

/// Append-only job log. Never updated, so a failure can be reconstructed.
model VisionJobEvent {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  kind      String
  stage     String?
  message   String?  @db.Text
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  job VisionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("vision_job_events")
}

/// What a job cost. Rolled up per match so the question "what did this match
/// cost to analyse?" has a measured number rather than an estimate.
model VisionJobCost {
  id                     String @id @default(uuid())
  jobId                  String @unique @map("job_id")
  gpuSeconds             Float  @default(0) @map("gpu_seconds")
  cpuSeconds             Float  @default(0) @map("cpu_seconds")
  wallClockSeconds       Float  @default(0) @map("wall_clock_seconds")
  bytesRead              BigInt @default(0) @map("bytes_read")
  bytesWritten           BigInt @default(0) @map("bytes_written")
  classAOperations       Int    @default(0) @map("class_a_operations")
  classBOperations       Int    @default(0) @map("class_b_operations")
  thirdPartyApiCostCents Int    @default(0) @map("third_party_api_cost_cents")
  estimatedUsdCents      Int    @default(0) @map("estimated_usd_cents")
  /// True when the figure came from a configured rate rather than a live quote,
  /// so a stale rate cannot silently make the cost trend misleading.
  fromConfiguredRate     Boolean  @default(true) @map("from_configured_rate")
  createdAt              DateTime @default(now()) @map("created_at")

  job VisionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("vision_job_costs")
}

/// An ephemeral worker. Registered on boot, retired when it drains and dies.
model VisionWorker {
  id            String @id @default(uuid())
  providerId    String @map("provider_id")
  providerRef   String? @map("provider_ref")
  resourceClass String  @map("resource_class")
  image         String
  /// Hashed. A worker token may only act on the job it currently holds.
  tokenHash      String    @unique @map("token_hash")
  tokenExpiresAt DateTime  @map("token_expires_at")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @updatedAt @map("last_seen_at")
  jobsCompleted  Int       @default(0) @map("jobs_completed")
  retiredAt      DateTime? @map("retired_at")

  @@index([providerId, resourceClass])
  @@index([lastSeenAt])
  @@map("vision_workers")
}

// ── Datasets and models (skeletons; filled out in Phases 2 and 3) ──────────

model VisionDatasetVersion {
  id          String    @id @default(uuid())
  label       String    @unique
  description String?   @db.Text
  manifestKey String?   @map("manifest_key")
  labelSchemaVersionId String? @map("label_schema_version_id")
  splitPolicy Json?     @map("split_policy")
  /// Proof that no duplicate cluster or match crosses a split. A dataset cannot be
  /// frozen while this fails, and the stored report is what a later reader trusts.
  leakageReport        Json?  @map("leakage_report")
  /// Distribution across competition, camera, lighting, resolution and source
  /// quality. How a corpus quietly dominated by one competition gets caught.
  representationReport Json?  @map("representation_report")
  frozenAt    DateTime? @map("frozen_at")
  frozenBy    String?   @map("frozen_by")
  /// Set by revocation. A frozen dataset is immutable, so history is never
  /// rewritten — but it can no longer back a new training run.
  containsRevokedMembers Boolean  @default(false) @map("contains_revoked_members")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  members            VisionDatasetMember[]
  jobs               VisionJob[]
  modelVersions      VisionModelVersion[]
  benchmarkRuns      VisionBenchmarkRun[]
  labelSchemaVersion VisionLabelSchemaVersion? @relation(fields: [labelSchemaVersionId], references: [id])

  @@map("vision_dataset_versions")
}

model VisionDatasetMember {
  id               String @id @default(uuid())
  datasetVersionId String @map("dataset_version_id")
  videoAssetId     String @map("video_asset_id")
  /// Denormalised on purpose: if the asset row is ever touched, the dataset can
  /// still prove which bytes it was built from.
  checksumSha256   String   @map("checksum_sha256")
  split            String
  /// Denormalised so the leakage checker can group without loading every asset, and
  /// so a frozen manifest still records how the grouping was decided even if the
  /// asset is later re-clustered.
  groupKey         String   @map("group_key")
  sbMatchId        String?  @map("sb_match_id")
  createdAt        DateTime @default(now()) @map("created_at")

  datasetVersion VisionDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  videoAsset     VisionVideoAsset     @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)

  @@unique([datasetVersionId, videoAssetId])
  @@index([datasetVersionId, split])
  @@index([datasetVersionId, groupKey])
  @@map("vision_dataset_members")
}

model VisionModel {
  id          String   @id @default(uuid())
  key         String   @unique
  task        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  versions VisionModelVersion[]

  @@map("vision_models")
}

model VisionModelVersion {
  id               String  @id @default(uuid())
  modelId          String  @map("model_id")
  version          String
  datasetVersionId String? @map("dataset_version_id")
  gitCommit        String? @map("git_commit")
  configKey        String? @map("config_key")
  weightsKey       String? @map("weights_key")
  weightsChecksum  String? @map("weights_checksum")
  workerImage      String? @map("worker_image")
  stage            String  @default("candidate")
  /// Licence position for the code, the weights, and any pretrained checkpoint
  /// this was initialised from. Fine-tuning an encumbered checkpoint produces
  /// an encumbered model, however clean the training data was.
  licenceNote      String?   @map("licence_note") @db.Text
  promotedBy       String?   @map("promoted_by")
  promotedAt       DateTime? @map("promoted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  model          VisionModel           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  datasetVersion VisionDatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  jobs              VisionJob[]
  benchmarkRuns     VisionBenchmarkRun[]
  promotionRequests VisionPromotionRequest[]

  @@unique([modelId, version])
  @@index([stage])
  @@map("vision_model_versions")
}

/// One scoring of a model version against a frozen gold dataset version.
///
/// The run is the unit of evidence a promotion rests on: which version, which
/// gold, which thresholds it was judged under, and the verdict. Metrics hang off
/// it per slice, never only as a headline, because that is exactly how a regression
/// on night footage hides behind an improved average.
model VisionBenchmarkRun {
  id               String  @id @default(uuid())
  modelVersionId   String  @map("model_version_id")
  datasetVersionId String  @map("dataset_version_id")
  jobId            String? @map("job_id")
  /// queued | running | completed | failed
  state            String  @default("queued")
  /// Which thresholds configuration judged this run. Changing a threshold is a
  /// reviewed change with a new version, never an edit during a release.
  thresholdsVersion String @map("thresholds_version")
  iouThreshold      Float  @map("iou_threshold")
  /// pass | fail | unthresholded. Null until the run completes.
  verdict          String?
  verdictDetail    Json?     @map("verdict_detail")
  summary          Json?
  reportKey        String?   @map("report_key")
  requestedBy      String?   @map("requested_by")
  failureReason    String?   @map("failure_reason") @db.Text
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  modelVersion      VisionModelVersion   @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  datasetVersion    VisionDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  metrics           VisionMetricResult[]
  promotionRequests VisionPromotionRequest[]

  @@index([modelVersionId, createdAt])
  @@index([datasetVersionId])
  @@map("vision_benchmark_runs")
}

/// A request to move a model version one stage up, and what became of it.
///
/// The two-person rule lives here: `requestedBy` holds `vision.models.train`,
/// `decidedBy` holds `vision.models.promote`, and they are never the same person.
/// The checks the gate ran are stored as they were at request time, so "why was
/// this allowed?" is answerable from the row and not from a re-run.
model VisionPromotionRequest {
  id             String  @id @default(uuid())
  modelVersionId String  @map("model_version_id")
  benchmarkRunId String? @map("benchmark_run_id")
  fromStage      String  @map("from_stage")
  toStage        String  @map("to_stage")
  /// pending | approved | rejected
  state          String  @default("pending")
  /// The promotion gate's findings at request time: passed, warnings, failures.
  checks         Json
  requestedBy      String  @map("requested_by")
  requestedByEmail String? @map("requested_by_email")
  decidedBy        String?   @map("decided_by")
  decidedByEmail   String?   @map("decided_by_email")
  decidedAt        DateTime? @map("decided_at")
  decisionReason   String?   @map("decision_reason") @db.Text
  /// Versions that were in production when this one took over, so rollback is one operation.
  replacedVersionIds Json?     @map("replaced_version_ids")
  rolledBackAt       DateTime? @map("rolled_back_at")
  rolledBackBy       String?   @map("rolled_back_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  modelVersion VisionModelVersion  @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  benchmarkRun VisionBenchmarkRun? @relation(fields: [benchmarkRunId], references: [id], onDelete: SetNull)

  @@index([modelVersionId, state])
  @@map("vision_promotion_requests")
}

/// One measured number: a metric for a class (or all), on a slice (or all).
model VisionMetricResult {
  id             String @id @default(uuid())
  benchmarkRunId String @map("benchmark_run_id")
  /// `"<name>:<class|all>"`, e.g. `recall:ball`, `ap:all`.
  metric         String
  /// `all`, or `"<axis>:<value>"` such as `quality:platform_copy`.
  slice          String
  /// Null when the slice has nothing to measure for this metric (no boxes of that class).
  value          Float?
  /// Ground-truth boxes the number rests on. A recall of 1.0 over three boxes is not a finding.
  support        Int    @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  benchmarkRun VisionBenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@unique([benchmarkRunId, metric, slice])
  @@map("vision_metric_results")
}

// ── Audit ─────────────────────────────────────────────────────────────────

/// Who did what. Covers raw youth-footage access, identity assignment,
/// annotation approval, model promotion, publication, rights change and
/// deletion requests.
model VisionAuditLog {
  id          String  @id @default(uuid())
  action      String
  targetKind  String  @map("target_kind")
  targetId    String? @map("target_id")
  /// Flat actor fields: api-key auth has no user row, and an audit trail has to
  /// outlive the user it refers to.
  actorId     String? @map("actor_id")
  actorEmail  String? @map("actor_email")
  actorMethod String? @map("actor_method")
  /// Required on a raw-footage read, so an access can always be justified.
  reason      String?  @db.Text
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([targetKind, targetId])
  @@index([actorId, createdAt])
  @@map("vision_audit_logs")
}

// ── Dataset factory — Phase 2 ─────────────────────────────────────────────

/// A versioned label taxonomy.
///
/// Changing what counts as a "pass" is a schema change with a migration, not a
/// quiet edit to a handbook — otherwise two annotators label the same footage
/// against different definitions and the disagreement looks like noise.
model VisionLabelSchemaVersion {
  id            String    @id @default(uuid())
  version       String    @unique
  /// The definitions themselves: classes, event taxonomy, required attributes.
  definitions   Json
  handbookKey   String?   @map("handbook_key")
  effectiveFrom DateTime  @map("effective_from")
  supersededAt  DateTime? @map("superseded_at")
  authoredBy    String?   @map("authored_by")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  annotationTasks VisionAnnotationTask[]
  datasetVersions VisionDatasetVersion[]

  @@map("vision_label_schema_versions")
}

/// One unit of annotation work: a window of one asset, sampled for a reason.
model VisionAnnotationTask {
  id                   String  @id @default(uuid())
  videoAssetId         String  @map("video_asset_id")
  labelSchemaVersionId String  @map("label_schema_version_id")
  /// Why this window was chosen. Random sampling produces a corpus of easy
  /// frames, so the strategy is recorded and the mix is auditable.
  samplingStrategy     String  @map("sampling_strategy")
  startMs              Int     @map("start_ms")
  endMs                Int     @map("end_ms")
  /// Flat actor id: an annotator may leave the organisation.
  assignedTo           String? @map("assigned_to")
  state                String
  /// Set when the drawing was done in an external tool.
  externalTaskRef      String? @map("external_task_ref")
  /// True when a model produced the starting labels. Reviewers must be able to
  /// see this — an unmarked pre-label is an anchoring-bias machine.
  preLabelled          Boolean @default(false) @map("pre_labelled")
  preLabelModelVersionId String? @map("pre_label_model_version_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  videoAsset         VisionVideoAsset          @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  labelSchemaVersion VisionLabelSchemaVersion  @relation(fields: [labelSchemaVersionId], references: [id])
  versions           VisionAnnotationVersion[]

  @@index([videoAssetId, state])
  @@index([assignedTo, state])
  @@index([samplingStrategy])
  @@map("vision_annotation_tasks")
}

/// One annotator's submission. Superseded, never edited.
///
/// The corrections are the training signal, so overwriting them throws away the
/// most valuable data DTP generates.
model VisionAnnotationVersion {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  /// Labels live in object storage; only the pointer and its checksum are here.
  payloadKey   String   @map("payload_key")
  payloadChecksum String @map("payload_checksum")
  annotatorId  String?  @map("annotator_id")
  supersedesId String?  @unique @map("supersedes_id")
  /// Minutes spent. Correction time is a first-class metric: a model that is 5%
  /// better but doubles it is worse for DTP.
  effortMinutes Float?  @map("effort_minutes")
  createdAt    DateTime @default(now()) @map("created_at")

  task       VisionAnnotationTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  supersedes VisionAnnotationVersion? @relation("AnnotationSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy VisionAnnotationVersion? @relation("AnnotationSupersedes")
  reviews    VisionReviewDecision[]

  @@index([taskId, createdAt])
  @@map("vision_annotation_versions")
}

/// A reviewer's verdict. Append-only.
model VisionReviewDecision {
  id                  String  @id @default(uuid())
  annotationVersionId String? @map("annotation_version_id")
  /// Generalised so the same table records verdicts on predictions and events too.
  targetKind          String  @map("target_kind")
  targetId            String  @map("target_id")
  decision            String
  /// Structured, because these drive the next sampling batch: wrong_box,
  /// wrong_identity, camera_cut, ball_invisible, event_ambiguous, roster_error,
  /// rights_issue.
  rejectionReason     String? @map("rejection_reason")
  reviewerId          String? @map("reviewer_id")
  notes               String? @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  annotationVersion VisionAnnotationVersion? @relation(fields: [annotationVersionId], references: [id], onDelete: SetNull)

  @@index([targetKind, targetId])
  @@index([reviewerId, createdAt])
  @@map("vision_review_decisions")
}

/// The correction loop, queued.
///
/// Ranked by low confidence, cross-stage disagreement, reviewer disagreement, a
/// new domain slice, or business value.
model VisionActiveLearningItem {
  id           String   @id @default(uuid())
  videoAssetId String   @map("video_asset_id")
  startMs      Int      @map("start_ms")
  endMs        Int      @map("end_ms")
  reason       String
  score        Float
  state        String   @default("queued")
  createdAt    DateTime @default(now()) @map("created_at")

  videoAsset VisionVideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@index([state, score])
  @@map("vision_active_learning_items")
}

/// Vision's proposal that something happened: a type from a versioned taxonomy, a
/// window in source time, an actor, and the evidence it rests on. The recorder's
/// `SbMatchEvent` stays canonical; a candidate two people stand behind enriches a
/// matching one, or creates one where the recorder logged nothing and a publisher
/// says so. Never edited: a correction is a new row superseding this one.
/// See docs/vision/44.
model VisionEventCandidate {
  id                      String   @id @default(uuid())
  videoAssetId            String   @map("video_asset_id")
  sbMatchId               String?  @map("sb_match_id")
  type                    String
  taxonomyVersion         String   @map("taxonomy_version")
  /// Source time, like every other label. An instant event has startMs == endMs.
  startMs                 Int      @map("start_ms")
  endMs                   Int      @map("end_ms")
  actorTrackId            String?  @map("actor_track_id")
  actorPlayerId           String?  @map("actor_player_id")
  /// The roster slot of this match the actor is, when a person named one.
  actorMatchSquadPlayerId String?  @map("actor_match_squad_player_id")
  sbTeamId                String?  @map("sb_team_id")
  confidence              Float
  /// manual | model
  method                  String
  modelVersionId          String?  @map("model_version_id")
  /// The camera segment covering startMs when the candidate was filed, if any.
  cameraSegmentId         String?  @map("camera_segment_id")
  /// False inside a replay, intro or halftime segment: flagged, and never promoted.
  inPlay                  Boolean  @default(true) @map("in_play")
  /// unreviewed | accepted | rejected
  reviewState             String   @default("unreviewed") @map("review_state")
  decidedBy               String   @map("decided_by")
  reviewedBy              String?  @map("reviewed_by")
  reviewNote              String?  @map("review_note")
  note                    String?
  promotedEventId         String?  @unique @map("promoted_event_id")
  /// enriched | created
  promotionKind           String?  @map("promotion_kind")
  promotedBy              String?  @map("promoted_by")
  promotedAt              DateTime? @map("promoted_at")
  supersededBy            String?  @map("superseded_by")
  createdAt               DateTime @default(now()) @map("created_at")

  videoAsset    VisionVideoAsset     @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  actorTrack    VisionTrack?         @relation(fields: [actorTrackId], references: [id], onDelete: SetNull)
  actorPlayer   Player?              @relation(fields: [actorPlayerId], references: [id], onDelete: SetNull)
  promotedEvent SbMatchEvent?        @relation(fields: [promotedEventId], references: [id], onDelete: SetNull)
  evidence      VisionEvidenceLink[]

  @@index([videoAssetId, startMs])
  @@index([sbMatchId])
  @@index([actorTrackId])
  @@map("vision_event_candidates")
}

/// What a candidate rests on: a track, a camera segment, a calibration, an identity
/// assignment, a clock anchor. The provenance drawer reads these; staleness
/// propagation (Phase 7) will walk them the other way.
model VisionEvidenceLink {
  id          String   @id @default(uuid())
  candidateId String   @map("candidate_id")
  kind        String
  targetId    String   @map("target_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  candidate VisionEventCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([kind, targetId])
  @@map("vision_evidence_links")
}
