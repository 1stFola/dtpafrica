# Generated by Ansible — do not edit manually.
# Last deployed: {{ ansible_date_time.iso8601 }}

# Postgres (used by docker-compose.staging.yml postgres service)
POSTGRES_USER={{ db_creds.POSTGRES_USER }}
POSTGRES_PASSWORD={{ db_creds.POSTGRES_PASSWORD }}
POSTGRES_DB={{ db_creds.POSTGRES_DB }}

# App secrets (passed into API container)
ADMIN_API_KEY={{ app_creds.ADMIN_API_KEY }}
# Session signing keys. Each its own value; the API will not start in production without
# them (services/api/src/shared/jwt-secrets.ts). Rotating one signs everybody out once.
ADMIN_JWT_SECRET={{ app_creds.ADMIN_JWT_SECRET }}
ACADEMY_JWT_SECRET={{ app_creds.ACADEMY_JWT_SECRET }}
# What the vision worker provisions itself with: sha256 of a fixed context and the operator
# key, as the API computes it (services/api/src/vision/worker/provision-key.ts). The worker's
# container is given this and not the operator key.
VISION_PROVISION_KEY={{ ('vision-worker-provision-v1:' ~ (app_creds.ADMIN_API_KEY | trim)) | hash('sha256') }}
OPENAI_API_KEY={{ app_creds.OPENAI_API_KEY | default('') }}
OPENAI_MODEL={{ app_creds.OPENAI_MODEL | default('gpt-5.5') }}
OCR_SPACE_API_KEY={{ app_creds.OCR_SPACE_API_KEY | default('') }}
OCR_SPACE_ENGINE={{ app_creds.OCR_SPACE_ENGINE | default('3') }}

# Vision Engine (see infra/DEPLOYMENT.md, "Turning Vision on"). Empty keeps it off.
# The worker service runs only under the `vision` compose profile, switched on here.
COMPOSE_PROFILES={{ 'vision' if (vision_on | default(false) | bool) else '' }}
VISION_ENABLED={{ app_creds.VISION_ENABLED | default('') }}
VISION_STORAGE_BACKEND={{ app_creds.VISION_STORAGE_BACKEND | default('') }}
VISION_COMPUTE_PROVIDER={{ app_creds.VISION_COMPUTE_PROVIDER | default('') }}
VISION_R2_ACCOUNT_ID={{ app_creds.VISION_R2_ACCOUNT_ID | default('') }}
VISION_R2_ACCESS_KEY_ID={{ app_creds.VISION_R2_ACCESS_KEY_ID | default('') }}
VISION_R2_SECRET_ACCESS_KEY={{ app_creds.VISION_R2_SECRET_ACCESS_KEY | default('') }}
VISION_R2_BUCKET_MASTER={{ app_creds.VISION_R2_BUCKET_MASTER | default('') }}
VISION_R2_BUCKET_DERIVED={{ app_creds.VISION_R2_BUCKET_DERIVED | default('') }}
VISION_R2_BUCKET_MODELS={{ app_creds.VISION_R2_BUCKET_MODELS | default('') }}
VISION_R2_BUCKET_CLIPS={{ app_creds.VISION_R2_BUCKET_CLIPS | default('') }}

# Images — built and pushed by CI, pulled here. IMAGE_TAG is the deployed commit.
IMAGE_REGISTRY={{ image_registry }}
IMAGE_TAG={{ image_tag }}

# Ports — WEB_PORT=80 overrides the 8080 default in docker-compose.staging.yml
WEB_PORT=80
API_PORT=3000
