# Generated by Ansible (roles/backup). Run by dtp-backup.timer; by hand:
#   sudo systemctl start dtp-backup.service && journalctl -u dtp-backup -n 50
[Unit]
Description=DTP Postgres backup to off-box storage
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/dtp-backup run
# Behind the site for CPU and disk: Postgres and the API come first.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
