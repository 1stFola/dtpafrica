# Local development
VITE_API_PROXY=http://localhost:3000

# API (services/api)
DATABASE_URL=postgresql://dtp:dtp@localhost:5432/dtp_africa
ADMIN_API_KEY=dtp-dev-admin-1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OCR_SPACE_API_KEY=
OCR_SPACE_ENGINE=3

# Staging docker compose
POSTGRES_USER=dtp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dtp_africa
WEB_PORT=8080
API_PORT=3000

# ── Vision Engine (docs/vision/) ────────────────────────────────────────────
# Off unless VISION_ENABLED is set, so leaving this block empty changes nothing.
# With it on, the API refuses to boot until the storage settings below are valid.
VISION_ENABLED=false

# Object storage. "memory" is for local development and tests; "r2" requires the
# credentials and all four bucket names.
VISION_STORAGE_BACKEND=memory
VISION_R2_ACCOUNT_ID=
VISION_R2_ENDPOINT=
VISION_R2_ACCESS_KEY_ID=
VISION_R2_SECRET_ACCESS_KEY=
VISION_R2_BUCKET_MASTER=
VISION_R2_BUCKET_DERIVED=
VISION_R2_BUCKET_MODELS=
VISION_R2_BUCKET_CLIPS=

# Resumable upload. 16 MiB parts keep a lost part cheap to retry on an unstable
# connection; the session outlives the browser so a partner can resume for days.
VISION_UPLOAD_PART_BYTES=16777216
VISION_UPLOAD_SESSION_TTL_HOURS=168
VISION_SIGNED_URL_TTL_PART_SECONDS=900
# Playback URLs stay short-lived: an issued URL is not a standing grant.
VISION_SIGNED_URL_TTL_PLAYBACK_SECONDS=300

# Jobs. Budgets are mandatory — an idle GPU pod nobody noticed is the commonest
# way to burn the month's compute allowance.
VISION_JOB_HEARTBEAT_SECONDS=30
VISION_JOB_MISSED_HEARTBEATS=3
VISION_WORKER_TOKEN_TTL_HOURS=12
VISION_JOB_BUDGET_SECONDS=7200
VISION_JOB_BUDGET_USD_CENTS=500

# Compute. "mock" and "local" are the Phase 0 providers; hosted providers land in
# Phase 1. VISION_MONTHLY_BUDGET_USD_CENTS caps new capacity for the month.
VISION_COMPUTE_PROVIDER=mock
VISION_WORKER_IMAGE=dtp-vision-engine:0.1.0
VISION_MONTHLY_BUDGET_USD_CENTS=20000

# Rate overrides, in USD per hour, when a provider's pricing changes. Unset means
# the indicative rates in docs/vision/12-COST-MODEL.md are used.
VISION_RATE_CPU_SMALL_USD_PER_HOUR=
VISION_RATE_GPU_24GB_USD_PER_HOUR=
VISION_RATE_GPU_48GB_USD_PER_HOUR=
VISION_RATE_GPU_80GB_USD_PER_HOUR=

# Policy defaults pending counsel confirmation — docs/vision/13-OPEN-QUESTIONS.md (O1).
VISION_TAKEDOWN_DELETE_WITHIN_DAYS=7
VISION_DSR_ACK_WITHIN_DAYS=7
VISION_DSR_COMPLETE_WITHIN_DAYS=30
VISION_DERIVED_RETENTION_MONTHS=24
