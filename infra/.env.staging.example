# Staging template. Copy to infra/.env.staging and replace secrets before a real deployment.
POSTGRES_USER=dtp
POSTGRES_PASSWORD=replace-with-a-long-staging-password
POSTGRES_DB=dtp_africa

# Interim admin guard. For local staging only, dtp-dev-admin-1 is acceptable.
ADMIN_API_KEY=replace-with-a-long-staging-admin-key

# Host/domain documentation values used by deployment runbooks.
STAGING_HOST=localhost
STAGING_DOMAIN=localhost
WEB_PORT=8080
API_PORT=3000

# Container images. CI overwrites both on the server at deploy time, tagging with
# the commit SHA. The values here exist so `docker compose config` resolves during
# validation and so the variables are documented; `local` is what deploy.sh builds.
IMAGE_REGISTRY=dtp
IMAGE_TAG=local
