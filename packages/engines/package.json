{
  "name": "@dtp/engines",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic scoring: SIP tactical, MVCE valuation, calibration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./placeholder-names": {
      "types": "./dist/scoreboard/placeholder-names.d.ts",
      "import": "./dist/scoreboard/placeholder-names.js",
      "default": "./dist/scoreboard/placeholder-names.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "build": "tsc && node ./scripts/copy-calibration-legacy.mjs",
    "calibrate": "node ./scripts/run-calibration.mjs",
    "lint": "echo ok"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^5.0.4",
    "allure-js-commons": "^3.13.0",
    "allure-vitest": "^3.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
